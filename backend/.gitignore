# Ignore dependencies
node_modules/
.pnp
.pnp.js

# Ignore environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore logs & temp files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# Ignore build output folders
dist/
build/

# Ignore Python cache / artifacts (if training ML scripts locally)
__pycache__/
*.pyc
*.pkl